print("The sum of {} and {} is {}".format(a, b, sum))
print(f"The sum of {a} and {b} is {sum}")

"""## PROG 1.2: Adding 2 Numbers Measuring Time"""

import time

start = time.time()

a = 10
b = 20

sum = a + b

end = time.time()

print(f"The sum of {a} and {b} is {sum}")
print(f"Execution time: {end - start} seconds")

