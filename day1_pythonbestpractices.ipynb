"""## PROG 6: Handling Exceptions Practice

The program here will demonstrate handling exception properly

### PROG 6.1: Handling User Error

This program demonstrates handling bad input error
"""

# PROG 6.1 Handling User Error

# Write the code here
try:
    total_sum = int(input("Enter value for Total Sum "))
    print("Total Sum is", total_sum)

except ValueError:
    print("Try Again and Enter a Proper Value")

"""### PROG 6.2: Handling Exact User Error

The following program handles the exact error that occurred during the program
"""

# 6.2 Handling Exact User Error

# Write the code here
try:
    total_sum = int(input("Enter value for Total Sum "))
    bonus_points = int(input("Enter value for Bonus Points "))

    print("Data Type of total_sum is", type(total_sum))
    print("Data Type of bonus_points is", type(bonus_points))

    print("Final Score is", total_sum + bonus_points)

except ValueError:
    print("Try Again and Enter a Proper Value")

