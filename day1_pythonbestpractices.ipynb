"""### PROG 4.2: Function Parameter Type Annotation Practice

By default function parameter is of any type, if possible annotate with proper type.
"""

# PROG 4.2: Function Parameter Type Annotation

# Write the code here
def score(total_sum: int, bonus_points: int) -> int:
    return total_sum + bonus_points

total_sum = 20
bonus_points = 10

print("Data Type of total_sum is", type(total_sum))
print("Data Type of bonus_points is", type(bonus_points))
print("Final Score is", score(total_sum, bonus_points))

